# Maintainer: Yangtse Su <yangtsesu@gmail.com>
# Local -git package. It builds the parent repository from this checkout, so
# commit your working tree before running makepkg. For AUR, replace the source
# entry with git+https://github.com/YangtseSu/fcitx5-ink.git.

pkgname=fcitx5-ink-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Handwriting input tool for fcitx5 with a GTK4 panel (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/YangtseSu/fcitx5-ink"
license=('GPL-3.0-or-later' 'MPL-2.0' 'BSD-3-Clause' 'LGPL-2.1-or-later')
depends=('fcitx5' 'gtk4' 'cairo' 'pango' 'glib2')
makedepends=('cmake' 'rust' 'nlohmann-json' 'tomlplusplus' 'pkgconf' 'python' 'git')
provides=('fcitx5-ink')
conflicts=('fcitx5-ink')
source=("$pkgname::git+file://$startdir/../../.."
        "handwriting-zh_CN.model::https://raw.githubusercontent.com/metasequoiaime/msime-engine/a9b9f092219505166c927843762b650d1e0e501d/handwriting/models/handwriting-zh_CN.model")
sha256sums=('SKIP' 'e16153d1ff267cd479aea260d6f71a3edda8b4ba06db2d121513adda65a4449e')

pkgver() {
  cd "$srcdir/$pkgname"
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  mkdir -p "$srcdir/model"
  cp -L "$srcdir/handwriting-zh_CN.model" "$srcdir/model/handwriting-zh_CN.model"
}

build() {
  cd "$srcdir/$pkgname"

  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --workspace

  cmake -S . -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFCITX5_INK_PANEL_BINARY="$srcdir/target/release/fcitx5-ink-panel" \
    -DFCITX5_INK_MODEL="$srcdir/model/handwriting-zh_CN.model"
  cmake --build "$srcdir/build" -j"$(nproc)"
}

check() {
  cd "$srcdir/$pkgname"
  MSIME_HANDWRITING_MODEL="$srcdir/model/handwriting-zh_CN.model" \
    CARGO_TARGET_DIR="$srcdir/target" \
    cargo test --workspace
  ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
